@{
    ViewData["Title"] = "Confirmar Transferencia";
    var originAccount = TempData["ConfirmOriginAccount"]?.ToString() ?? "";
    var destAccount = TempData["ConfirmDestAccount"]?.ToString() ?? "";
    var amount = decimal.Parse(TempData["ConfirmAmount"]?.ToString() ?? "0");
}

<div class="container-xxl py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header text-center py-4" style="background: linear-gradient(135deg, #f59e0b, #f97316); border-radius: 16px 16px 0 0;">
                    <h4 class="fw-bold text-white mb-0"><i class="fa-solid fa-circle-exclamation me-2"></i>Confirmar Transacci&oacute;n</h4>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div style="width:60px; height:60px; border-radius:50%; background:rgba(245,158,11,0.1); display:flex; align-items:center; justify-content:center; margin:0 auto;">
                            <i class="fa-solid fa-right-left fa-lg" style="color:#f59e0b;"></i>
                        </div>
                        <p class="mt-3 fw-semibold" style="color:#334155;">&iquest;Est&aacute; seguro de que desea realizar esta transacci&oacute;n?</p>
                    </div>

                    <div class="p-3 mb-3" style="background:#f8fafc; border-radius:10px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Cuenta origen</span>
                            <span class="fw-bold" style="font-family:monospace;">@originAccount</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Cuenta destino</span>
                            <span class="fw-bold" style="font-family:monospace;">@destAccount</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between">
                            <span class="text-muted fw-bold">Monto</span>
                            <span class="fw-bold" style="color:#16a34a; font-size:1.2rem;">RD$@amount.ToString("N2")</span>
                        </div>
                    </div>

                    <form method="post" asp-action="TransferConfirm" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <a asp-action="Transfer" class="btn btn-outline-secondary flex-fill fw-semibold" style="border-radius:8px;">
                            <i class="fa-solid fa-xmark me-1"></i>Cancelar
                        </a>
                        <button type="submit" name="confirm" value="yes" class="btn btn-primary flex-fill fw-semibold" style="background:linear-gradient(135deg,#16a34a,#22c55e); border:none; border-radius:8px;">
                            <i class="fa-solid fa-check me-1"></i>Confirmar Asignaci&oacute;n
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
