@model IEnumerable<ABP.Core.Application.ViewModels.Transactions.TransactionViewModel>
@{
    ViewData["Title"] = ViewBag.IsAdminView == true ? "Todas las Transacciones" : "Historial de Transacciones";
    bool isAdminView = ViewBag.IsAdminView == true;
}

<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-list-check me-2" style="color: #1a56db;"></i>
                @(isAdminView ? "Monitoreo de Transacciones" : "Movimientos de Cuenta")
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">
                @(isAdminView ? "Todas las transacciones registradas en el sistema." : "Historial detallado de todas tus operaciones.")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-dark" style="font-weight: 600; border-radius: 8px;">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <div class="card bg-transparent border-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;">
                <i class="fa-solid fa-file-invoice-dollar mb-3" style="font-size: 3rem; color: #cbd5e1;"></i>
                <h5 class="text-dark fw-bold">Sin Movimientos</h5>
                <p class="text-muted mb-0">Esta cuenta aún no registra ninguna transacción.</p>
            </div>
        }
        else
        {
            <div class="table-responsive bg-white" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;">
                <table class="table table-hover table-borderless align-middle mb-0 text-dark">
                    <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
                        <tr>
                            <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Fecha</th>
                            <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Tipo</th>
                            <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Descripción</th>
                            <th class="py-3 px-4 text-muted fw-semibold text-end" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Monto</th>
                            <th class="py-3 px-4 text-muted fw-semibold text-center" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td class="py-3 px-4">
                                    <div class="fw-semibold text-dark" style="font-family: 'Outfit', sans-serif;">@t.TransactionDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.8rem;">@t.TransactionDate.ToLocalTime().ToString("hh:mm tt")</div>
                                </td>
                                <td class="py-3 px-4">
                                    @switch (t.Type)
                                    {
                                        case ABP.Core.Domain.Common.Enums.TransactionType.Credit:
                                            <span class="badge" style="background:#dcfce7;color:#166534;padding:0.3rem 0.6rem;border-radius:6px;">Crédito</span>
                                            break;
                                        case ABP.Core.Domain.Common.Enums.TransactionType.Debit:
                                            <span class="badge" style="background:#fee2e2;color:#991b1b;padding:0.3rem 0.6rem;border-radius:6px;">Débito</span>
                                            break;
                                        case ABP.Core.Domain.Common.Enums.TransactionType.Transfer:
                                            <span class="badge" style="background:#e0e7ff;color:#4338ca;padding:0.3rem 0.6rem;border-radius:6px;">Transferencia</span>
                                            break;
                                        case ABP.Core.Domain.Common.Enums.TransactionType.Deposit:
                                            <span class="badge" style="background:#dcfce7;color:#166534;padding:0.3rem 0.6rem;border-radius:6px;">Depósito</span>
                                            break;
                                        case ABP.Core.Domain.Common.Enums.TransactionType.Withdrawal:
                                            <span class="badge" style="background:#fee2e2;color:#991b1b;padding:0.3rem 0.6rem;border-radius:6px;">Retiro</span>
                                            break;
                                        case ABP.Core.Domain.Common.Enums.TransactionType.CashAdvance:
                                            <span class="badge" style="background:#fef9c3;color:#854d0e;padding:0.3rem 0.6rem;border-radius:6px;">Avance Efectivo</span>
                                            break;
                                        case ABP.Core.Domain.Common.Enums.TransactionType.CreditCardPayment:
                                            <span class="badge" style="background:#fee2e2;color:#991b1b;padding:0.3rem 0.6rem;border-radius:6px;">Débito</span>
                                            break;
                                        case ABP.Core.Domain.Common.Enums.TransactionType.LoanPayment:
                                            <span class="badge" style="background:#fee2e2;color:#991b1b;padding:0.3rem 0.6rem;border-radius:6px;">Débito</span>
                                            break;
                                        default:
                                            <span class="badge" style="background:#f1f5f9;color:#475569;padding:0.3rem 0.6rem;border-radius:6px;">@t.Type</span>
                                            break;
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    <div style="font-family: monospace; font-size: 0.95rem;" class="text-dark">
                                        @if (t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Debit || t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Withdrawal || t.Type == ABP.Core.Domain.Common.Enums.TransactionType.CreditCardPayment || t.Type == ABP.Core.Domain.Common.Enums.TransactionType.LoanPayment)
                                        {
                                            <span class="text-muted me-2">A:</span> @t.Beneficiary
                                        }
                                        else
                                        {
                                            <span class="text-muted me-2">De:</span> @t.Origin
                                        }
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    @{
                                        string amountStr = t.Amount.ToString("N2");
                                        string colorClass = (t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Credit || t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Deposit) ? "text-success" : "text-dark";
                                        string sign = (t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Credit || t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Deposit) ? "+" : "-";
                                    }
                                    <div class="@colorClass fw-bold fs-5" style="font-family: 'Outfit', sans-serif;">
                                        @sign$@amountStr
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @if (t.Status == ABP.Core.Domain.Common.Enums.TransactionStatus.Approved)
                                    {
                                        <span class="badge rounded-pill" style="background:#dcfce7;color:#166534;font-weight:600;">Aprobado</span>
                                    }
                                    else if (t.Status == ABP.Core.Domain.Common.Enums.TransactionStatus.Rejected)
                                    {
                                        <span class="badge rounded-pill" style="background:#fee2e2;color:#991b1b;font-weight:600;">Rechazado</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill" style="background:#f1f5f9;color:#475569;font-weight:600;">@t.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
