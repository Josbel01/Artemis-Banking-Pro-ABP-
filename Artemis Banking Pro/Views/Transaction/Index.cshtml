@model IEnumerable<ABP.Core.Application.Dtos.Transactions.TransactionDto>
@{
    ViewData["Title"] = "Historial de Transacciones";
}


<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-list-check me-2" style="color: #1a56db;"></i>Movimientos de Cuenta
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Historial detallado de todas tus operaciones.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Transfer" class="btn btn-outline-primary" style="font-weight: 600; border-radius: 8px;">
                <i class="fa-solid fa-money-bill-transfer me-2"></i>Transferir
            </a>
            <a href="/" class="btn btn-outline-dark" style="font-weight: 600; border-radius: 8px;">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <div class="card bg-transparent border-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;">
                <i class="fa-solid fa-file-invoice-dollar mb-3" style="font-size: 3rem; color: #cbd5e1;"></i>
                <h5 class="text-dark fw-bold">Sin Movimientos</h5>
                <p class="text-muted mb-0">Esta cuenta aún no registra ninguna transacción.</p>
            </div>
        }
        else
        {
            <div class="table-responsive bg-white" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;">
                <table class="table table-hover table-borderless align-middle mb-0 text-dark">
                    <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
                        <tr>
                            <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Fecha</th>
                            <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Descripción</th>
                            <th class="py-3 px-4 text-muted fw-semibold text-end" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td class="py-3 px-4">
                                    <div class="fw-semibold text-dark" style="font-family: 'Outfit', sans-serif;">@t.TransactionDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.8rem;">@t.TransactionDate.ToLocalTime().ToString("hh:mm tt")</div>
                                </td>
                                <td class="py-3 px-4">
                                    <div style="font-family: monospace; font-size: 0.95rem;" class="text-dark">
                                        @if (t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Debit)
                                        {
                                            <span class="text-muted me-2">A:</span> @t.Beneficiary
                                        }
                                        else
                                        {
                                            <span class="text-muted me-2">De:</span> @t.Origin
                                        }
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    @{
                                        string amountStr = t.Amount.ToString("N2");
                                        string colorClass = t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Credit ? "text-success" : "text-dark";
                                        string sign = t.Type == ABP.Core.Domain.Common.Enums.TransactionType.Credit ? "+" : "-";
                                    }
                                    <div class="@colorClass fw-bold fs-5" style="font-family: 'Outfit', sans-serif;">
                                        @sign$@amountStr
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
