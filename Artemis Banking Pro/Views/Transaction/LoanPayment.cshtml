@model ABP.Core.Application.ViewModels.Transactions.SaveLoanPaymentViewModel
@{
    ViewData["Title"] = "Pago a Préstamo";
    var accounts = ViewBag.ClientAccounts as List<ABP.Core.Application.Dtos.SavingAccounts.SavingAccountDto>;
    var loans = ViewBag.ClientLoans as List<ABP.Core.Application.Dtos.Loans.LoanDto>;
}

<div class="container-xxl px-4 mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <a href="/Client/Index" class="text-muted mb-4 d-inline-block text-decoration-none" style="transition: color 0.2s;">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver al Inicio
            </a>

            <div class="card border-0 overflow-hidden" style="background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                <div class="card-header border-0 bg-transparent p-4 pb-0">
                    <h3 class="text-dark fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">
                        <i class="fa-solid fa-hand-holding-dollar me-2" style="color: #2d5da1;"></i>Pago a Préstamo
                    </h3>
                    <p class="text-muted mt-1" style="font-size: 0.85rem;">Realiza abonos a tu préstamo activo desde tu cuenta de ahorro.</p>
                </div>

                <div class="card-body p-4 pt-3">
                    <form asp-action="LoanPayment" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Préstamo: Dropdown -->
                        <div class="mb-4">
                            <label class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Préstamo a Pagar</label>
                            <select asp-for="LoanNumber" class="form-select bg-light text-dark" style="border: 1px solid #e5e7eb; font-family: monospace; font-size: 1rem; box-shadow: none;">
                                <option value="">-- Selecciona un préstamo --</option>
                                @if (loans != null)
                                {
                                    foreach (var loan in loans)
                                    {
                                        <option value="@loan.LoanNumber">
                                            #@loan.LoanNumber — Pendiente: @loan.AmountPending.ToString("C", new System.Globalization.CultureInfo("es-DO"))
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="LoanNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Cuenta origen: Dropdown -->
                        <div class="mb-4">
                            <label class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Cuenta de Origen</label>
                            <select asp-for="OriginAccountNumber" class="form-select bg-light text-dark" style="border: 1px solid #e5e7eb; font-family: monospace; font-size: 1rem; box-shadow: none;">
                                <option value="">-- Selecciona una cuenta --</option>
                                @if (accounts != null)
                                {
                                    foreach (var acc in accounts)
                                    {
                                        <option value="@acc.AccountNumber">
                                            @acc.AccountNumber — Balance: @acc.Balance.ToString("C", new System.Globalization.CultureInfo("es-DO"))
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="OriginAccountNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Amount" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Monto a Pagar (RD$)</label>
                            <div class="position-relative">
                                <span class="position-absolute text-dark fs-4 fw-bold" style="left: 15px; top: 50%; transform: translateY(-50%); font-family: 'Outfit', sans-serif;">$</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control bg-light text-dark fw-bold" style="border: 1px solid #e5e7eb; font-family: 'Outfit', sans-serif; font-size: 2rem; box-shadow: none; padding-left: 40px; height: 70px;" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text mt-2"><i class="fa-solid fa-info-circle me-1"></i>Si el monto supera el saldo pendiente, solo se aplicará el monto real adeudado.</div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold" style="background: #2d5da1; border: none; border-radius: 10px; font-size: 1.05rem; box-shadow: 0 4px 15px rgba(45,93,161,0.3); transition: all 0.3s ease;">
                            <i class="fa-solid fa-check-circle me-2"></i>Confirmar Pago
                        </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
