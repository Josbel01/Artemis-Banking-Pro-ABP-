@model ABP.Core.Application.ViewModels.Transactions.SaveTransferViewModel
@{
    ViewData["Title"] = "Transferencia Express";
}


<div class="container-xxl px-4 mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <a href="/" class="text-muted mb-4 d-inline-block text-decoration-none" style="transition: color 0.2s;">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver al Inicio
            </a>

            <div class="card border-0 overflow-hidden" style="background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                <div class="card-header border-0 bg-transparent p-4 pb-0">
                    <h3 class="text-dark fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">
                        <i class="fa-solid fa-money-bill-transfer me-2" style="color: #2d5da1;"></i>Transferencia
                    </h3>
                    <p class="text-muted mt-1" style="font-size: 0.85rem;">Mueve tu dinero al instante y sin complicaciones.</p>
                </div>

                <div class="card-body p-4 pt-3">
                    <form asp-action="Transfer" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Origen -->
                        <div class="mb-4">
                            <label asp-for="OriginAccountNumber" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Desde mi Cuenta</label>
                            <!-- Idealmente aqui iria un <select> con las cuentas del usuario. Por ahora usamos input para que funcione el DTO manual -->
                            <input asp-for="OriginAccountNumber" class="form-control bg-light text-dark" style="border: 1px solid #e5e7eb; font-family: monospace; font-size: 1.1rem; box-shadow: none;" placeholder="Ingresa tu número de cuenta origen" />
                            <span asp-validation-for="OriginAccountNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Destino -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="DestinationAccountNumber" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Hacia la Cuenta</label>
                                <a href="/Beneficiary" class="fw-semibold" style="color: #2d5da1; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-address-book me-1"></i>Ver mis Beneficiarios</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted" style="border: 1px solid #e5e7eb;"><i class="fa-solid fa-building-columns"></i></span>
                                <input asp-for="DestinationAccountNumber" class="form-control bg-light border-start-0 ps-0 text-dark" style="border: 1px solid #e5e7eb; font-family: monospace; font-size: 1.1rem; box-shadow: none;" placeholder="Ej: 0000123456" />
                            </div>
                            <span asp-validation-for="DestinationAccountNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Monto -->
                        <div class="mb-5">
                            <label asp-for="Amount" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Monto a transferir (RD$)</label>
                            <div class="position-relative">
                                <span class="position-absolute text-dark fs-4 fw-bold" style="left: 15px; top: 50%; transform: translateY(-50%); font-family: 'Outfit', sans-serif;">$</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control bg-light text-dark fw-bold" style="border: 1px solid #e5e7eb; font-family: 'Outfit', sans-serif; font-size: 2rem; box-shadow: none; padding-left: 40px; height: 70px;" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold" style="background: #2d5da1; border: none; border-radius: 10px; font-size: 1.05rem; box-shadow: 0 4px 15px rgba(45,93,161,0.3); transition: all 0.3s ease;">
                            <i class="fa-solid fa-paper-plane me-2"></i>Confirmar Transferencia
                        </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
