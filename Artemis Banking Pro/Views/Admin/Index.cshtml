@model ABP.Core.Application.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Panel de Administrador";
}

<div class="container-xxl py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--navy-text);">Panel de Administración</h2>
            <p class="text-muted mb-0">Bienvenido al área de administración de Artemis Banking Pro</p>
        </div>
        <div>
            <span class="badge" style="background-color: var(--navy-text); color: white; padding: 0.5rem 1rem; border-radius: 50px;">
                <i class="fa-solid fa-shield-halved me-2"></i>Admin
            </span>
        </div>
    </div>

    <!-- Indicadores de Productos Financieros Activos -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 h-100 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="d-flex align-items-center mb-3">
                    <div style="width:48px; height:48px; border-radius:10px; background-color:rgba(22,163,74,0.1); display:flex; align-items:center; justify-content:center; color:#16a34a; font-size:1.5rem; margin-right:1rem;">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--navy-text);">Préstamos Vigentes</h5>
                    </div>
                </div>
                <h2 class="fw-bold" style="color: #16a34a;">@Model.ActiveLoans</h2>
                <p class="text-muted small mb-0">Préstamos actualmente activos en el sistema.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 h-100 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="d-flex align-items-center mb-3">
                    <div style="width:48px; height:48px; border-radius:10px; background-color:rgba(26,86,219,0.1); display:flex; align-items:center; justify-content:center; color:#1a56db; font-size:1.5rem; margin-right:1rem;">
                        <i class="fa-solid fa-credit-card"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--navy-text);">Tarjetas de Crédito Activas</h5>
                    </div>
                </div>
                <h2 class="fw-bold" style="color: #1a56db;">@Model.ActiveCreditCards</h2>
                <p class="text-muted small mb-0">Tarjetas de crédito actualmente activas en el sistema.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 h-100 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="d-flex align-items-center mb-3">
                    <div style="width:48px; height:48px; border-radius:10px; background-color:rgba(53,104,178,0.1); display:flex; align-items:center; justify-content:center; color:var(--navy-text); font-size:1.5rem; margin-right:1rem;">
                        <i class="fa-solid fa-piggy-bank"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--navy-text);">Cuentas de Ahorro Activas</h5>
                    </div>
                </div>
                <h2 class="fw-bold" style="color: var(--navy-text);">@Model.ActiveSavingAccounts</h2>
                <p class="text-muted small mb-0">Cuentas de ahorro actualmente activas en el sistema.</p>
            </div>
        </div>
    </div>

    <!-- Panel de Gestión -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 h-100 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="d-flex align-items-center mb-3">
                    <div style="width:48px; height:48px; border-radius:10px; background-color:rgba(53,104,178,0.1); display:flex; align-items:center; justify-content:center; color:var(--navy-text); font-size:1.5rem; margin-right:1rem;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <h5 class="fw-bold mb-0" style="color: var(--navy-text);">Usuarios</h5>
                </div>
                <p class="text-muted small mb-0">Gestión de usuarios del sistema, clientes, cajeros y administradores.</p>
                <div class="mt-3">
                    <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="User" asp-action="Index">Gestionar <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 h-100 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="d-flex align-items-center mb-3">
                    <div style="width:48px; height:48px; border-radius:10px; background-color:rgba(26,86,219,0.1); display:flex; align-items:center; justify-content:center; color:#1a56db; font-size:1.5rem; margin-right:1rem;">
                        <i class="fa-solid fa-vault"></i>
                    </div>
                    <h5 class="fw-bold mb-0" style="color: var(--navy-text);">Productos</h5>
                </div>
                <p class="text-muted small mb-0">Configuración de cuentas de ahorro, préstamos y tarjetas de crédito.</p>
                <div class="mt-3 dropdown">
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Gestionar
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="SavingAccount" asp-action="Index"><i class="fa-solid fa-piggy-bank me-2" style="color:#3568b2;"></i>Cuentas de Ahorro</a></li>
                        <li><a class="dropdown-item" asp-controller="CreditCard" asp-action="Index"><i class="fa-solid fa-credit-card me-2" style="color:#1a56db;"></i>Tarjetas de Crédito</a></li>
                        <li><a class="dropdown-item" asp-controller="Loan" asp-action="Index"><i class="fa-solid fa-hand-holding-dollar me-2" style="color:#16a34a;"></i>Préstamos</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 h-100 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div class="d-flex align-items-center mb-3">
                    <div style="width:48px; height:48px; border-radius:10px; background-color:rgba(22,163,74,0.1); display:flex; align-items:center; justify-content:center; color:#16a34a; font-size:1.5rem; margin-right:1rem;">
                        <i class="fa-solid fa-money-bill-transfer"></i>
                    </div>
                    <h5 class="fw-bold mb-0" style="color: var(--navy-text);">Transacciones</h5>
                </div>
                <p class="text-muted small mb-0">Monitoreo de transferencias y pagos realizados en el sistema.</p>
                <div class="mt-3">
                    <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="Transaction" asp-action="Index">Ver <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>
