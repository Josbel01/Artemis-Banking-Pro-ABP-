@model ABP.Core.Application.ViewModels.User.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Olvidé mi Contraseña";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Recuperar Contraseña</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">
                            @ViewBag.Message
                        </div>
                        <a href="@Url.Action("Index", "Account")" class="btn btn-primary w-100">Ir a Iniciar Sesión</a>
                    }
                    else
                    {
                        <p class="text-muted mb-3">Ingrese su nombre de usuario para recibir un enlace de restablecimiento.</p>
                        <form asp-action="ForgotPassword" method="post">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            
                            <div class="form-group mb-3">
                                <label asp-for="UserName" class="form-label">Nombre de Usuario</label>
                                <input asp-for="UserName" class="form-control" placeholder="Ingrese su nombre de usuario" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Enviar enlace de recuperación</button>
                            <a href="@Url.Action("Index", "Account")" class="btn btn-secondary w-100 mt-2">Volver</a>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
