@model IEnumerable<ABP.Core.Application.ViewModels.CreditCards.CreditCardViewModel>
@{
    ViewData["Title"] = "Mis Tarjetas de Crédito";
}

<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-regular fa-credit-card me-2" style="color: #1a56db;"></i>Mis Tarjetas de Crédito
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Visualiza y gestiona tus productos de crédito.</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;">
                    <i class="fa-regular fa-credit-card mb-3" style="font-size: 3rem; color: #cbd5e1;"></i>
                    <h5 class="text-dark fw-bold">Aún no tienes tarjetas de crédito</h5>
                    <p class="text-muted mb-0">Solicita una tarjeta para disfrutar de nuestros beneficios.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var card in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 text-white position-relative overflow-hidden" style="border-radius: 16px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); box-shadow: 0 10px 25px rgba(15, 23, 42, 0.2); transition: transform 0.2s, box-shadow 0.2s;">
                        
                        <!-- Card Design Elements -->
                        <div class="position-absolute" style="top: -20px; right: -20px; width: 120px; height: 120px; background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%); border-radius: 50%;"></div>
                        <div class="position-absolute" style="bottom: -30px; left: -30px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 70%); border-radius: 50%;"></div>

                        <div class="card-body p-4 position-relative z-1 d-flex flex-column justify-content-between">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="fs-4 fw-bold fst-italic" style="color: #cbd5e1;">Artemis Bank</div>
                                <i class="fa-brands fa-cc-visa fs-1" style="color: rgba(255,255,255,0.8);"></i>
                            </div>

                            <div class="mb-4">
                                <p class="mb-0" style="font-family: monospace; font-size: 1.3rem; letter-spacing: 2px;">
                                    @{
                                        // Mask card number for display
                                        var mask = card.CardNumber.Length >= 4 ? "**** **** **** " + card.CardNumber.Substring(card.CardNumber.Length - 4) : card.CardNumber;
                                    }
                                    @mask
                                </p>
                            </div>

                            <div class="d-flex justify-content-between">
                                <div>
                                    <small class="text-uppercase text-white-50" style="font-size: 0.65rem; letter-spacing: 1px;">Expira</small>
                                    <div class="fw-semibold" style="font-size: 0.9rem;">@card.ExpirationDate.ToString("MM/yy")</div>
                                </div>
                                <div class="text-end">
                                    <small class="text-uppercase text-white-50" style="font-size: 0.65rem; letter-spacing: 1px;">Estado</small>
                                    <div class="fw-semibold text-uppercase" style="font-size: 0.9rem;">
                                        @if (card.Status == ABP.Core.Domain.Common.Enums.CreditCardStatus.Active)
                                        {
                                            <span class="text-success"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i>Activa</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i>@card.Status</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer with Info -->
                        <div class="card-footer p-0 border-0 bg-white" style="border-radius: 0 0 16px 16px;">
                            <div class="p-3">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Disponible</span>
                                    <span class="fw-bold text-success">@card.AvailableCredit.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                    <span class="text-muted small">Deuda Actual</span>
                                    <span class="fw-bold text-danger">@card.CurrentDebt.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="text-muted small">Límite Total</span>
                                    <span class="fw-bold text-dark">@card.CreditLimit.ToString("C")</span>
                                </div>
                                <a href="/CardTransaction/Index?creditCardId=@card.Id" class="btn btn-outline-primary w-100 btn-sm fw-semibold" style="border-radius: 8px;">
                                    Ver Transacciones
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .col > .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.15) !important;
    }
</style>
