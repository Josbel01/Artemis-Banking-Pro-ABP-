@model IEnumerable<ABP.Core.Application.ViewModels.CreditCards.CreditCardViewModel>
@{
    ViewData["Title"] = "Gestión de Tarjetas de Crédito";
    var clients = ViewBag.Clients as List<ABP.Core.Application.Dtos.User.UserDto>;
}

<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-regular fa-credit-card me-2" style="color: #1a56db;"></i>Gestión de Tarjetas de Crédito
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Administra las tarjetas de crédito asignadas a los clientes del banco.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(135deg, #1a56db, #3b82f6); border: none; font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 8px; box-shadow: 0 4px 12px rgba(26,86,219,0.3); transition: all 0.3s ease;">
            <i class="fa-solid fa-plus me-2"></i>Asignar tarjeta de crédito
        </a>
    </div>

    <!-- Animated Card Gallery -->
    @if (Model.Any())
    {
        <div class="mb-5">
            <h6 class="fw-bold mb-3" style="color: #0b1f3a; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">
                <i class="fa-regular fa-eye me-2"></i>Vista Previa de Tarjetas Activas
            </h6>
            <div class="row g-4">
                @foreach (var card in Model.Where(c => c.Status == ABP.Core.Domain.Common.Enums.CreditCardStatus.Active).Take(6))
                {
                    var maskedNumber = card.CardNumber.Length >= 4
                        ? "•••• •••• •••• " + card.CardNumber.Substring(card.CardNumber.Length - 4)
                        : "•••• •••• •••• ••••";
                    var exp = card.ExpirationDate.ToString("MM/yy");
                    var available = card.CreditLimit - card.CurrentDebt;

                    <div class="col-md-6 col-lg-4">
                        @await Html.PartialAsync("_CreditCardAnimated", new
                        {
                            CardNumber = maskedNumber,
                            CreditLimit = card.CreditLimit,
                            CurrentDebt = card.CurrentDebt,
                            ExpirationDate = exp,
                            ClientName = card.ClientName ?? "Cliente",
                            CardId = card.Id
                        })
                        <div class="text-center mt-2">
                            <small class="text-muted" style="font-size: 0.75rem;">
                                <i class="fa-solid fa-user me-1"></i>@card.ClientName
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="card bg-white border-0 mb-4 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e5e7eb !important;">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-muted fw-semibold small">Buscar por Cédula del Cliente</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-id-card text-muted"></i></span>
                    <input type="text" name="identification" class="form-control border-start-0" placeholder="Ej. 00112345678" value="@ViewBag.Identification">
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold small">Filtrar por Estado</label>
                <select name="status" class="form-select">
                    <option value="" selected="@(ViewBag.Status == null || ViewBag.Status == "" || ViewBag.Status == "Todas" ? "selected" : null)">Todas</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active" ? "selected" : null)">Activas</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled" ? "selected" : null)">Canceladas</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100 fw-semibold" style="border-radius: 8px;">
                    <i class="fa-solid fa-filter me-2"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table -->
    <div class="card bg-white border-0" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h6 class="fw-bold mb-0" style="color: #0b1f3a; font-size: 0.85rem;">
                <i class="fa-solid fa-list me-2 text-muted"></i>Listado de Tarjetas
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
                    <tr>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Número de Tarjeta</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Cliente</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Límite de Crédito</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Monto Adeudado</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Expiración</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Estado</th>
                        <th class="py-3 px-4 text-muted fw-semibold text-end" style="font-size: 0.8rem; text-transform: uppercase;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted">No se encontraron tarjetas que coincidan con los criterios de búsqueda.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var card in Model)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td class="py-3 px-4 fw-semibold text-dark" style="font-family: monospace;">
                                    @{
                                        var mask = card.CardNumber.Length >= 4 ? "**** **** **** " + card.CardNumber.Substring(card.CardNumber.Length - 4) : card.CardNumber;
                                    }
                                    @mask
                                </td>
                                <td class="py-3 px-4 text-dark">@card.ClientName</td>
                                <td class="py-3 px-4 fw-bold text-dark">@card.CreditLimit.ToString("C")</td>
                                <td class="py-3 px-4 fw-bold" style="color: #991b1b;">@card.CurrentDebt.ToString("C")</td>
                                <td class="py-3 px-4 text-muted">@card.ExpirationDate.ToString("MM/yy")</td>
                                <td class="py-3 px-4">
                                    @if (card.Status == ABP.Core.Domain.Common.Enums.CreditCardStatus.Active)
                                    {
                                        <span class="badge rounded-pill" style="background-color: #dcfce7; color: #166534; font-weight: 600;">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill" style="background-color: #fee2e2; color: #991b1b; font-weight: 600;">Cancelada</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a href="/CardTransaction/Index?creditCardId=@card.Id" class="btn btn-sm btn-outline-primary" style="border-radius: 6px;" title="Ver Detalles">
                                            <i class="fa-solid fa-eye me-1"></i>Ver Detalles
                                        </a>
                                        @if (card.Status == ABP.Core.Domain.Common.Enums.CreditCardStatus.Active)
                                        {
                                            <a href="/CreditCard/EditLimit?id=@card.Id" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px;" title="Editar Límite">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form asp-action="Cancel" method="post" style="display:inline;" onsubmit="return confirm('¿Está seguro que desea cancelar la tarjeta @mask del cliente @card.ClientName con un límite de @card.CreditLimit.ToString("C")?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@card.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;" title="Cancelar">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if ((int)ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3" style="border-top: 1px solid #f1f5f9;">
                <small class="text-muted">Mostrando @((ViewBag.CurrentPage - 1) * 20 + 1) - @(Math.Min((int)ViewBag.CurrentPage * 20, (int)ViewBag.TotalRecords)) de @ViewBag.TotalRecords registros</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, identification = ViewBag.Identification, status = ViewBag.Status })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
