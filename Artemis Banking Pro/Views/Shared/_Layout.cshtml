<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Artemis Banking Pro — Plataforma de Banca Digital. Gestión de cuentas, préstamos y tarjetas con seguridad bancaria." />
    <title>@ViewData["Title"] — Artemis Banking Pro</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />

    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ABP Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="@ViewBag.BodyClass">

    @* ── Navbar — hidden on login ── *@
    @if (ViewBag.HideNav != true)
    {
        <div class="abp-navbar-wrapper">
            <nav class="navbar navbar-expand-lg abp-navbar">
                <div class="container-xxl">
                    <a class="navbar-brand" href="/">
                        <div class="abp-brand-icon">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                        Artemis Banking Pro
                    </a>

                    <button class="navbar-toggler border-0" type="button"
                            data-bs-toggle="collapse" data-bs-target="#abpNav"
                            aria-controls="abpNav" aria-expanded="false" aria-label="Menú"
                            style="color: var(--navy-text);">
                        <i class="fa-solid fa-bars-staggered"></i>
                    </button>

                    <div class="collapse navbar-collapse" id="abpNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link active" href="/">
                                    <i class="fa-solid fa-chart-pie"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="fa-solid fa-users"></i> Usuarios
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-vault"></i> Productos
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-piggy-bank me-2" style="color:#3568b2;"></i>Cuentas de Ahorro</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-credit-card me-2" style="color:#1a56db;"></i>Tarjetas de Crédito</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fa-solid fa-hand-holding-dollar me-2" style="color:#16a34a;"></i>Préstamos</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Transaction">
                                    <i class="fa-solid fa-money-bill-transfer"></i> Transacciones
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center gap-3">
                            <div class="d-none d-md-flex align-items-center gap-2" style="background: rgba(53,104,178,0.06); padding: 0.35rem 0.8rem 0.35rem 0.35rem; border-radius: 50px;">
                                <div class="abp-brand-icon" style="width:36px;height:36px;font-size:1.1rem;border-radius:50%;">
                                    <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "Admin")&background=3568b2&color=fff&bold=true" alt="User" style="width:100%;height:100%;border-radius:50%;" />
                                </div>
                                <div class="d-flex flex-column justify-content-center">
                                    <div style="font-size:0.8rem;font-weight:700;color:var(--navy-text);line-height:1.2;">
                                        @(User.Identity?.Name ?? "Usuario")
                                    </div>
                                    <div style="font-size:0.65rem;font-weight:600;color:#3568b2;line-height:1;">Administrador</div>
                                </div>
                            </div>
                            <a href="/Account/Logout"
                               style="background: #fee2e2; color: #dc2626; font-size: 0.85rem; font-weight: 700; padding: 0.5rem 1rem; border-radius: 50px; transition: all 0.2s; display: flex; align-items: center; gap: 0.4rem; text-decoration: none;"
                               onmouseover="this.style.background='#fca5a5'; this.style.color='#991b1b';"
                               onmouseout="this.style.background='#fee2e2'; this.style.color='#dc2626';">
                                <i class="fa-solid fa-power-off"></i> Salir
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
    }

    @* ── Flash messages ── *@
    @if (ViewBag.HideNav != true)
    {
        <div class="container-xxl px-4 mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="abp-alert abp-alert-success alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="abp-alert abp-alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>@TempData["ErrorMessage"]</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="abp-alert abp-alert-info alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>@TempData["InfoMessage"]</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    }

    @* ── Main ── *@
    <main role="main">
        @RenderBody()
    </main>

    @* ── Footer ── *@
    @if (ViewBag.HideNav != true)
    {
        <footer class="abp-footer">
            <div class="container-xxl px-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <span>
                        <strong style="color:#0b1f3a;">Artemis Banking Pro</strong>
                        &copy; @DateTime.Now.Year &mdash; Plataforma de Banca Digital ITLA
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge-active" style="display:flex;align-items:center;gap:.3rem;">
                            <i class="fa-solid fa-shield-halved"></i> SSL 256-bit
                        </span>
                        <span style="color:#d0d9e8;">|</span>
                        <span class="badge-warning" style="display:flex;align-items:center;gap:.3rem;">
                            <i class="fa-solid fa-circle" style="font-size:.45rem;"></i> Sistema Activo
                        </span>
                    </div>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
