@model ABP.Core.Application.ViewModels.Loans.SaveLoanViewModel
@{
    ViewData["Title"] = "Asignar Préstamo";
    var clients = ViewBag.Clients as List<ABP.Core.Application.Dtos.User.UserDto>;
}

<div class="container-xxl px-4 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="d-flex align-items-center mb-4 justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(26,86,219,0.1); color: #1a56db;">
                        <i class="fa-solid fa-hand-holding-dollar fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-bold mb-0" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">Asignar Préstamo</h2>
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">Complete los datos para generar el préstamo y su tabla de amortización.</p>
                    </div>
                </div>
                @if(ViewBag.AverageDebt != null)
                {
                    <div class="bg-light p-3 rounded text-end border">
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size:0.75rem;">Deuda Promedio (Clientes Activos)</small>
                        <span class="fs-5 fw-bold text-primary">@(((decimal)ViewBag.AverageDebt).ToString("C"))</span>
                    </div>
                }
            </div>

            <div class="card border-0" style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                <div class="card-body p-4 p-md-5">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" style="border-radius: 10px;">
                            <i class="fa-solid fa-circle-exclamation me-2"></i><strong>Ocurrieron errores:</strong>
                            <div class="mt-2">
                                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                            </div>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Buscar Cliente por Cédula</label>
                            <input type="text" id="dniSearch" class="form-control mb-2" placeholder="Ingrese cédula para filtrar..." />

                            <label asp-for="ClientId" class="form-label fw-bold text-dark">Seleccione el Cliente <span class="text-danger">*</span></label>
                            <select asp-for="ClientId" id="clientSelect" class="form-select form-select-lg" style="border-radius: 10px; background-color: #f8fafc;" required>
                                <option value="">-- Seleccionar --</option>
                                @if (clients != null)
                                {
                                    foreach (var client in clients)
                                    {
                                        <option value="@client.Id" data-dni="@client.DNI" data-email="@client.Email">@client.FirstName @client.LastName (@client.DNI)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ClientId" class="text-danger small"></span>
                        </div>
                        
                        <div id="clientInfo" class="alert alert-info" style="display:none;">
                            <strong>Información del Cliente:</strong><br />
                            Correo: <span id="clientEmail"></span><br />
                        </div>

                        <div class="mb-4">
                            <label asp-for="PrincipalAmount" class="form-label fw-bold text-dark">Monto a Prestar (Capital) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 fw-bold" style="border-radius: 10px 0 0 10px;">RD$</span>
                                <input asp-for="PrincipalAmount" type="number" step="0.01" min="1000" class="form-control form-control-lg border-start-0" style="border-radius: 0 10px 10px 0; background-color: #f8fafc;" required />
                            </div>
                            <span asp-validation-for="PrincipalAmount" class="text-danger small"></span>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="InterestRate" class="form-label fw-bold text-dark">Tasa de Interés Anual <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="InterestRate" type="number" step="0.01" min="0.1" max="100" class="form-control form-control-lg border-end-0" style="border-radius: 10px 0 0 10px; background-color: #f8fafc;" required />
                                    <span class="input-group-text bg-light border-start-0 fw-bold" style="border-radius: 0 10px 10px 0;">%</span>
                                </div>
                                <span asp-validation-for="InterestRate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TermInMonths" class="form-label fw-bold text-dark">Plazo (Meses) <span class="text-danger">*</span></label>
                                <select asp-for="TermInMonths" class="form-select form-select-lg" style="border-radius: 10px; background-color: #f8fafc;" required>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="6">6 meses</option>
                                    <option value="12">12 meses</option>
                                    <option value="18">18 meses</option>
                                    <option value="24">24 meses (2 años)</option>
                                    <option value="30">30 meses</option>
                                    <option value="36">36 meses (3 años)</option>
                                    <option value="42">42 meses</option>
                                    <option value="48">48 meses (4 años)</option>
                                    <option value="54">54 meses</option>
                                    <option value="60">60 meses (5 años)</option>
                                </select>
                                <span asp-validation-for="TermInMonths" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-5">
                            <a asp-action="Index" class="btn btn-light py-2 px-4 fw-semibold" style="border-radius: 8px;">Cancelar</a>
                            <button type="submit" class="btn btn-primary py-2 px-4 fw-bold flex-grow-1" style="border-radius: 8px; background: linear-gradient(135deg, #1a56db, #3b82f6); border: none;">
                                Registrar Préstamo
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dniSearch = document.getElementById('dniSearch');
            const clientSelect = document.getElementById('clientSelect');
            const options = Array.from(clientSelect.options);
            
            dniSearch.addEventListener('keyup', function () {
                const term = this.value.toLowerCase();
                clientSelect.innerHTML = '';
                
                options.forEach(opt => {
                    const dni = opt.getAttribute('data-dni') || '';
                    if (opt.value === '' || dni.toLowerCase().includes(term)) {
                        clientSelect.appendChild(opt);
                    }
                });
            });

            clientSelect.addEventListener('change', function () {
                const selected = this.options[this.selectedIndex];
                const infoDiv = document.getElementById('clientInfo');
                if (selected.value) {
                    document.getElementById('clientEmail').textContent = selected.getAttribute('data-email');
                    infoDiv.style.display = 'block';
                } else {
                    infoDiv.style.display = 'none';
                }
            });
        });
    </script>
}
