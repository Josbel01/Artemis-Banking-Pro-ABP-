@model List<ABP.Core.Application.ViewModels.Common.ClientSelectionViewModel>
@{
    ViewData["Title"] = "Asignar Préstamo - Seleccionar Cliente";
}

<div class="container-xxl px-4 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            
            <div class="d-flex align-items-center mb-4 justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(26,86,219,0.1); color: #1a56db;">
                        <i class="fa-solid fa-hand-holding-dollar fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-bold mb-0" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">Asignar Préstamo</h2>
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">Paso 1: Seleccione el cliente al que le asignará el préstamo.</p>
                    </div>
                </div>
                @if(ViewBag.AverageDebt != null)
                {
                    <div class="bg-light p-3 rounded text-end border">
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size:0.75rem;">Deuda Promedio (Clientes Activos)</small>
                        <span class="fs-5 fw-bold text-primary">@(((decimal)ViewBag.AverageDebt).ToString("C"))</span>
                    </div>
                }
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" style="border-radius: 10px;">
                    <i class="fa-solid fa-circle-exclamation me-2"></i><strong>Ocurrieron errores:</strong>
                    <div class="mt-2">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" style="border-radius: 10px;">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <!-- Search bar -->
            <div class="card border-0 mb-4" style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                <div class="card-body p-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="dniSearch" class="form-control form-control-lg border-start-0" 
                               placeholder="Buscar cliente por cédula..." 
                               style="border-radius: 0 10px 10px 0; background-color: #f8fafc;" />
                    </div>
                </div>
            </div>

            <!-- Client selection form -->
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="card border-0" style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" id="clientTable">
                                <thead style="background-color: #f8fafc;">
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>Cédula</th>
                                        <th>Nombre y apellido</th>
                                        <th>Correo electrónico</th>
                                        <th class="text-end">Monto total de deuda</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var client in Model)
                                        {
                                            <tr class="client-row" data-dni="@client.DNI">
                                                <td class="text-center align-middle">
                                                    <input type="radio" name="SelectedClientId" value="@client.ClientId" 
                                                           class="form-check-input client-radio" required />
                                                </td>
                                                <td class="align-middle fw-semibold">@client.DNI</td>
                                                <td class="align-middle">@client.FullName</td>
                                                <td class="align-middle text-muted">@client.Email</td>
                                                <td class="align-middle text-end fw-bold" style="color: #0b1f3a;">@client.TotalDebt.ToString("C")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">No hay clientes disponibles sin préstamo activo.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-light py-2 px-4 fw-semibold" style="border-radius: 8px;">
                        <i class="fa-solid fa-arrow-left me-2"></i>Volver atrás
                    </a>
                    <button type="submit" class="btn btn-primary py-2 px-4 fw-bold flex-grow-1" style="border-radius: 8px; background: linear-gradient(135deg, #1a56db, #3b82f6); border: none;">
                        Siguiente paso <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('dniSearch');
            const table = document.getElementById('clientTable');
            const rows = table.querySelectorAll('.client-row');

            searchInput.addEventListener('keyup', function () {
                const term = this.value.toLowerCase();
                rows.forEach(row => {
                    const dni = row.getAttribute('data-dni') || '';
                    row.style.display = dni.toLowerCase().includes(term) ? '' : 'none';
                });
            });
        });
    </script>
}
