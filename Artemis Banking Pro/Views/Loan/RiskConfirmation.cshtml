@{
    ViewData["Title"] = "Evaluación de Riesgo";
}

<div class="container-xxl px-4 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="d-flex align-items-center mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(220,38,38,0.1); color: #dc2626;">
                    <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                </div>
                <div>
                    <h2 class="h4 fw-bold mb-0" style="color: #0b1f3a;">Advertencia de Riesgo</h2>
                    <p class="text-muted mb-0" style="font-size: 0.85rem;">Evaluación de riesgo del cliente</p>
                </div>
            </div>

            <div class="card border-0" style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                <div class="card-body p-4 p-md-5">
                    
                    <div class="alert alert-warning" style="border-radius: 10px; background: #fef9c3; border: 1px solid #ca8a04;">
                        <div class="d-flex align-items-start">
                            <i class="fa-solid fa-triangle-exclamation mt-1 me-3" style="color: #ca8a04; font-size: 1.2rem;"></i>
                            <div>
                                <strong style="color: #854d0e;">@TempData["RiskMessage"]</strong>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 rounded" style="background: #f8fafc;">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Cliente</small>
                                <div class="fw-bold" style="color: #0b1f3a;">@TempData["RiskClientName"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded" style="background: #f8fafc;">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Deuda Promedio del Sistema</small>
                                <div class="fw-bold" style="color: #0b1f3a;">RD$@TempData["RiskAvgDebt"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded" style="background: #f8fafc;">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Deuda Actual del Cliente</small>
                                <div class="fw-bold" style="color: #dc2626;">RD$@TempData["RiskCurrentDebt"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded" style="background: #f8fafc;">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Deuda Proyectada</small>
                                <div class="fw-bold" style="color: #dc2626;">RD$@TempData["RiskProjectedDebt"]</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <form asp-action="RiskConfirm" method="post" class="flex-grow-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="confirm" value="no" />
                            <a asp-action="Index" class="btn btn-light py-2 px-4 fw-semibold w-100" style="border-radius: 8px;">
                                <i class="fa-solid fa-arrow-left me-2"></i>Cancelar
                            </a>
                        </form>
                        <form asp-action="RiskConfirm" method="post" class="flex-grow-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="confirm" value="yes" />
                            <button type="submit" class="btn btn-warning py-2 px-4 fw-bold w-100" style="border-radius: 8px;">
                                <i class="fa-solid fa-check me-2"></i>Confirmar Asignación
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
