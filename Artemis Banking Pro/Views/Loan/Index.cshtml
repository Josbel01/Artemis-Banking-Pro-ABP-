@model IEnumerable<ABP.Core.Application.ViewModels.Loans.LoanViewModel>
@{
    ViewData["Title"] = "Gestión de Préstamos";
    var clients = ViewBag.Clients as List<ABP.Core.Application.Dtos.User.UserDto>;
}

<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-hand-holding-dollar me-2" style="color: #1a56db;"></i>Gestión de Préstamos
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Administra los préstamos asignados a los clientes del banco.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(135deg, #1a56db, #3b82f6); border: none; font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 8px; box-shadow: 0 4px 12px rgba(26,86,219,0.3); transition: all 0.3s ease;">
            <i class="fa-solid fa-plus me-2"></i>Asignar préstamo
        </a>
    </div>

    <!-- Filters -->
    <div class="card bg-white border-0 mb-4 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e5e7eb !important;">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-muted fw-semibold small">Buscar por Cédula del Cliente</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-id-card text-muted"></i></span>
                    <input type="text" name="identification" class="form-control border-start-0" placeholder="Ej. 00112345678" value="@ViewBag.Identification">
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold small">Filtrar por Estado</label>
                <select name="status" class="form-select">
                    <option value="Todos" selected="@(ViewBag.Status == "Todos" ? "selected" : null)">Todos</option>
                    <option value="Activo" selected="@(ViewBag.Status == "Activo" ? "selected" : null)">Activos</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed" ? "selected" : null)">Completados</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100 fw-semibold" style="border-radius: 8px;">
                    <i class="fa-solid fa-filter me-2"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table -->
    <div class="card bg-white border-0" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
                    <tr>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Número de Préstamo</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Cliente</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Capital Aprobado</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Monto Pendiente</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Tasa</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Plazo</th>
                        <th class="py-3 px-4 text-muted fw-semibold text-center" style="font-size: 0.8rem; text-transform: uppercase;">Cuotas</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Estado</th>
                        <th class="py-3 px-4 text-muted fw-semibold" style="font-size: 0.8rem; text-transform: uppercase;">Estado Cliente</th>
                        <th class="py-3 px-4 text-muted fw-semibold text-end" style="font-size: 0.8rem; text-transform: uppercase;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="text-muted">No se encontraron préstamos que coincidan con los criterios de búsqueda.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var loan in Model)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td class="py-3 px-4 fw-semibold text-dark" style="font-family: monospace;">@loan.LoanNumber</td>
                                <td class="py-3 px-4 text-dark">@loan.ClientName</td>
                                <td class="py-3 px-4 fw-bold text-dark">@loan.PrincipalAmount.ToString("C")</td>
                                <td class="py-3 px-4 fw-bold" style="color: #991b1b;">@loan.RemainingDebt.ToString("C")</td>
                                <td class="py-3 px-4 text-muted">@loan.InterestRate%</td>
                                <td class="py-3 px-4 text-muted">@loan.TermInMonths meses</td>
                                <td class="py-3 px-4 text-center">@loan.PaidInstallments / @loan.TotalInstallments</td>
                                <td class="py-3 px-4">
                                    @if (loan.Status == ABP.Core.Domain.Common.Enums.LoanStatus.Active)
                                    {
                                        <span class="badge rounded-pill" style="background-color: #dcfce7; color: #166534; font-weight: 600;">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill" style="background-color: #f1f5f9; color: #475569; font-weight: 600;">Completado</span>
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    @{
                                        var clientPaymentStatus = loan.ClientPaymentStatus;
                                    }
                                    @if (clientPaymentStatus == ABP.Core.Domain.Common.Enums.ClientPaymentStatus.UpToDate)
                                    {
                                        <span class="badge rounded-pill" style="background-color: #dcfce7; color: #166534; font-weight: 600;">Al día</span>
                                    }
                                    else if (clientPaymentStatus == ABP.Core.Domain.Common.Enums.ClientPaymentStatus.Defaulted)
                                    {
                                        <span class="badge rounded-pill" style="background-color: #fee2e2; color: #991b1b; font-weight: 600;">En mora</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill" style="background-color: #f1f5f9; color: #475569; font-weight: 600;">@clientPaymentStatus</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a href="/LoanInstallment/Index?loanId=@loan.Id" class="btn btn-sm btn-outline-primary" style="border-radius: 6px;">
                                            <i class="fa-solid fa-list-ul"></i> Detalles
                                        </a>
                                        @if (loan.Status == ABP.Core.Domain.Common.Enums.LoanStatus.Active)
                                        {
                                            <a href="/Loan/EditRate?id=@loan.Id" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px;" title="Editar Tasa">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if ((int)ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3" style="border-top: 1px solid #f1f5f9;">
                <small class="text-muted">Mostrando @((ViewBag.CurrentPage - 1) * 20 + 1) - @(Math.Min((int)ViewBag.CurrentPage * 20, (int)ViewBag.TotalRecords)) de @ViewBag.TotalRecords registros</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, identification = ViewBag.Identification, status = ViewBag.Status })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
