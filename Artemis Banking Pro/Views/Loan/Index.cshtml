@model IEnumerable<ABP.Core.Application.ViewModels.Loans.LoanViewModel>
@{
    ViewData["Title"] = "Mis Préstamos";
}

<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-hand-holding-dollar me-2" style="color: #1a56db;"></i>Mis Préstamos
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Consulta el estado y progreso de tus préstamos activos.</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;">
                    <i class="fa-solid fa-file-invoice-dollar mb-3" style="font-size: 3rem; color: #cbd5e1;"></i>
                    <h5 class="text-dark fw-bold">No tienes préstamos registrados</h5>
                    <p class="text-muted mb-0">Comunícate con un representante para solicitar un préstamo.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var loan in Model)
            {
                <div class="col">
                    <div class="card h-100 bg-white border-0 position-relative overflow-hidden" style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #e5e7eb !important; transition: transform 0.2s, box-shadow 0.2s;">
                        
                        <div class="card-body p-4 position-relative z-1 d-flex flex-column justify-content-between">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px; background: rgba(26,86,219,0.1); color: #1a56db;">
                                        <i class="fa-solid fa-sack-dollar fs-5"></i>
                                    </div>
                                    <h5 class="card-title text-dark fw-bold mb-0">Préstamo #@loan.Id</h5>
                                    <small class="text-muted" style="font-family: monospace;">@loan.LoanNumber</small>
                                </div>
                                <div class="text-end">
                                    @if (loan.Status == ABP.Core.Domain.Common.Enums.LoanStatus.Active)
                                    {
                                        <span class="badge rounded-pill" style="background-color: #dcfce7; color: #166534; font-weight: 600;">Activo</span>
                                    }
                                    else if (loan.Status == ABP.Core.Domain.Common.Enums.LoanStatus.Completed)
                                    {
                                        <span class="badge rounded-pill" style="background-color: #f1f5f9; color: #475569; font-weight: 600;">Pagado</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill" style="background-color: #fee2e2; color: #991b1b; font-weight: 600;">@loan.Status</span>
                                    }
                                </div>
                            </div>

                            <div class="mb-4 text-center">
                                <h3 class="fw-bold mb-0" style="color: #0f172a; font-family: 'Outfit', sans-serif;">@loan.RemainingDebt.ToString("C")</h3>
                                <small class="text-muted text-uppercase fw-semibold" style="letter-spacing: 1px; font-size: 0.7rem;">Deuda Restante</small>
                            </div>

                            <div class="mb-3">
                                @{
                                    decimal progressPercentage = loan.PrincipalAmount > 0 ? (loan.AmountPaid / loan.PrincipalAmount) * 100 : 0;
                                }
                                <div class="d-flex justify-content-between mb-1" style="font-size: 0.8rem;">
                                    <span class="text-muted fw-semibold">Progreso</span>
                                    <span class="text-primary fw-bold">@progressPercentage.ToString("0.0")%</span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: #e2e8f0;">
                                    <div class="progress-bar" role="progressbar" style="width: @progressPercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%; background: linear-gradient(90deg, #1a56db, #3b82f6); border-radius: 10px;" aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between pt-3 border-top">
                                <div class="text-center flex-fill border-end">
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">Principal</small>
                                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@loan.PrincipalAmount.ToString("C")</span>
                                </div>
                                <div class="text-center flex-fill">
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">Pagado</small>
                                    <span class="fw-bold text-success" style="font-size: 0.9rem;">@loan.AmountPaid.ToString("C")</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-light border-0 p-0 text-center">
                            <a href="/LoanInstallment/Index?loanId=@loan.Id" class="btn btn-link w-100 py-3 text-decoration-none fw-semibold" style="color: #1a56db; transition: all 0.2s;">
                                Ver Cuotas <i class="fa-solid fa-chevron-right ms-1" style="font-size: 0.8rem;"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .col > .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08) !important;
        border-color: rgba(26,86,219,0.2) !important;
    }
    .col > .card .btn-link:hover {
        background-color: rgba(26,86,219,0.05);
    }
</style>
