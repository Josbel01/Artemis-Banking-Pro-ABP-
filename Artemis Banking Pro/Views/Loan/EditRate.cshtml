@model ABP.Core.Application.ViewModels.Loans.UpdateLoanRateViewModel
@{
    ViewData["Title"] = "Editar Tasa de Interés";
}

<div class="container-xxl px-4 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="d-flex align-items-center mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(26,86,219,0.1); color: #1a56db;">
                    <i class="fa-solid fa-pen fs-5"></i>
                </div>
                <div>
                    <h2 class="h4 fw-bold mb-0" style="color: #0b1f3a;">Editar Tasa de Interés</h2>
                    <p class="text-muted mb-0" style="font-size: 0.85rem;">Modificar la tasa de interés anual del préstamo.</p>
                </div>
            </div>

            <!-- Loan info card -->
            <div class="card border-0 mb-4" style="border-radius: 16px; border: 1px solid #e5e7eb !important; background: rgba(26,86,219,0.03);">
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Préstamo</small>
                            <div class="fw-semibold" style="color: #0b1f3a;">@ViewBag.LoanNumber</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Cliente</small>
                            <div class="fw-semibold" style="color: #0b1f3a;">@ViewBag.ClientName</div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Tasa Actual</small>
                            <div class="fw-bold" style="color: #16a34a;">@ViewBag.CurrentRate%</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0" style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                <div class="card-body p-4 p-md-5">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" style="border-radius: 10px;">
                            <i class="fa-solid fa-circle-exclamation me-2"></i><strong>Ocurrieron errores:</strong>
                            <div class="mt-2">
                                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                            </div>
                        </div>
                    }

                    <form asp-action="EditRate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="AnnualInterestRate" class="form-label fw-bold text-dark">Nueva Tasa de Interés Anual <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="AnnualInterestRate" type="number" step="0.01" min="0" max="100" class="form-control form-control-lg border-end-0" style="border-radius: 10px 0 0 10px; background-color: #f8fafc;" required />
                                <span class="input-group-text bg-light border-start-0 fw-bold" style="border-radius: 0 10px 10px 0;">%</span>
                            </div>
                            <span asp-validation-for="AnnualInterestRate" class="text-danger small"></span>
                            <div class="form-text mt-2"><i class="fa-solid fa-info-circle me-1"></i>Se recalcularán automáticamente las cuotas futuras pendientes.</div>
                        </div>

                        <div class="d-flex gap-3 mt-5">
                            <a asp-action="Index" class="btn btn-light py-2 px-4 fw-semibold" style="border-radius: 8px;">
                                <i class="fa-solid fa-arrow-left me-2"></i>Volver atrás
                            </a>
                            <button type="submit" class="btn btn-primary py-2 px-4 fw-bold flex-grow-1" style="border-radius: 8px; background: linear-gradient(135deg, #1a56db, #3b82f6); border: none;">
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
