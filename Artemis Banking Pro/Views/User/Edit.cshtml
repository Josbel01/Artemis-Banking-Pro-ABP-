@model ABP.Core.Application.ViewModels.User.UpdateUserViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-pen-to-square me-2" style="color: #1a56db;"></i>Editar Usuario
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Actualizar datos del usuario existente</p>
        </div>
        <a href="/User/Index" class="btn btn-outline-secondary d-none d-sm-inline-block" style="border-radius: 8px; font-weight: 600;">
            <i class="fa-solid fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card bg-white border-0 shadow-sm" style="border-radius: 16px; border: 1px solid #e5e7eb !important;">
                <div class="card-body p-5">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>
                        
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Nombre</label>
                                <input asp-for="Name" class="form-control form-control-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Apellido</label>
                                <input asp-for="LastName" class="form-control form-control-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Usuario</label>
                                <input asp-for="UserName" class="form-control form-control-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Identification" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Cédula</label>
                                <input asp-for="Identification" class="form-control form-control-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;" />
                                <span asp-validation-for="Identification" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Correo Electrónico</label>
                                <input asp-for="Email" class="form-control form-control-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Nueva Contraseña (Opcional)</label>
                                <input asp-for="Password" type="password" class="form-control form-control-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;" placeholder="Dejar en blanco para no cambiar" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Confirmar Contraseña</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;" placeholder="Repita la nueva contraseña" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.5px;">Rol de Sistema</label>
                                <select asp-for="Role" class="form-select form-select-lg bg-light" style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 1rem;">
                                    <option value="">Seleccione un rol...</option>
                                    <option value="Admin">Administrador (Admin)</option>
                                    <option value="Cashier">Cajero (Cashier)</option>
                                    <option value="Client">Cliente (Client)</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6 d-flex align-items-center pt-4">
                                <div class="form-check form-switch fs-5">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="flexSwitchCheckDefault">
                                    <label class="form-check-label ms-2 fs-6 fw-semibold text-muted" for="flexSwitchCheckDefault">Usuario Activo</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary py-3 fw-bold fs-5" style="background: linear-gradient(135deg, #1a56db, #3b82f6); border: none; border-radius: 8px; box-shadow: 0 4px 12px rgba(26,86,219,0.3); transition: all 0.3s ease;">
                                <i class="fa-solid fa-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
