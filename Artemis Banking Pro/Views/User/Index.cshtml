@model IEnumerable<ABP.Core.Application.ViewModels.User.UserViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-xxl px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light border-opacity-10">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0b1f3a; font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-users me-2" style="color: #1a56db;"></i>Usuarios del Sistema
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Administra todos los usuarios y sus roles.</p>
        </div>
        <a href="/User/Create" class="btn btn-primary d-none d-sm-inline-block" style="background: linear-gradient(135deg, #1a56db, #3b82f6); border: none; font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 8px; box-shadow: 0 4px 12px rgba(26,86,219,0.3); transition: all 0.3s ease;">
            <i class="fa-solid fa-user-plus me-2"></i>Nuevo Usuario
        </a>
    </div>

    <!-- Filters -->
    <div class="card bg-white border-0 mb-4 p-4" style="border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e5e7eb !important;">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-muted fw-semibold small">Filtrar por Rol</label>
                <select name="filterRole" class="form-select">
                    <option value="" selected="@(ViewBag.CurrentFilter == null ? "selected" : null)">Todos</option>
                    <option value="Admin" selected="@(ViewBag.CurrentFilter == "Admin" ? "selected" : null)">Administrador</option>
                    <option value="Cashier" selected="@(ViewBag.CurrentFilter == "Cashier" ? "selected" : null)">Cajero</option>
                    <option value="Client" selected="@(ViewBag.CurrentFilter == "Client" ? "selected" : null)">Cliente</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100 fw-semibold" style="border-radius: 8px;">
                    <i class="fa-solid fa-filter me-2"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="card bg-white border-0 shadow-sm" style="border-radius: 16px; border: 1px solid #e5e7eb !important;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc;">
                        <tr>
                            <th class="text-uppercase text-muted fw-bold ps-4" style="font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding: 1rem;">Usuario</th>
                            <th class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding: 1rem;">Cédula</th>
                            <th class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding: 1rem;">Nombre</th>
                            <th class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding: 1rem;">Correo</th>
                            <th class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding: 1rem;">Roles</th>
                            <th class="text-uppercase text-muted fw-bold text-center" style="font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding: 1rem;">Estado</th>
                            <th class="text-uppercase text-muted fw-bold text-end pe-4" style="font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; padding: 1rem;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-users-slash fs-1 mb-3 text-light"></i>
                                    <p class="mb-0">No se encontraron usuarios.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-semibold text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: rgba(26,86,219,0.1); color: #1a56db;">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            @user.UserName
                                        </div>
                                    </td>
                                    <td class="py-3 text-muted">@user.Identification</td>
                                    <td class="py-3 text-muted">@user.Name @user.LastName</td>
                                    <td class="py-3 text-muted">@user.Email</td>
                                    <td class="py-3">
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            foreach (var role in user.Roles)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border border-secondary border-opacity-25 me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin rol</span>
                                        }
                                    </td>
                                    <td class="py-3 text-center">
                                        @if (user.IsActive)
                                        {
                                            <span class="badge" style="background-color: #dcfce7; color: #166534; padding: 0.4rem 0.8rem; font-weight: 600;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: #fee2e2; color: #991b1b; padding: 0.4rem 0.8rem; font-weight: 600;">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 32px; height: 32px; padding: 0;">
                                                <i class="fa-solid fa-ellipsis-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="border-radius: 10px;">
                                                <li><a class="dropdown-item" href="/User/Edit/@user.Id"><i class="fa-solid fa-pen text-primary me-2"></i> Editar</a></li>
                                                @if (user.IsActive)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#confirmModal" data-action="ToggleStatus" data-id="@user.Id" data-message="¿Está seguro que desea inactivar este usuario?" data-btn-text="Inactivar" data-btn-class="btn-danger"><i class="fa-solid fa-ban me-2"></i> Inactivar</button>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item text-success" data-bs-toggle="modal" data-bs-target="#confirmModal" data-action="ToggleStatus" data-id="@user.Id" data-message="¿Está seguro que desea activar este usuario?" data-btn-text="Activar" data-btn-class="btn-success"><i class="fa-solid fa-check me-2"></i> Activar</button>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if ((int)ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3" style="border-top: 1px solid #f1f5f9;">
                <small class="text-muted">Mostrando @((ViewBag.CurrentPage - 1) * 20 + 1) - @(Math.Min((int)ViewBag.CurrentPage * 20, (int)ViewBag.TotalRecords)) de @ViewBag.TotalRecords registros</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, filterRole = ViewBag.CurrentFilter })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-body text-center p-5">
                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; background: rgba(26,86,219,0.1);">
                    <i class="fa-solid fa-circle-question fs-3" style="color: #1a56db;"></i>
                </div>
                <h5 class="fw-bold" style="color: #0b1f3a;" id="confirmModalLabel"></h5>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-light px-4" style="border-radius: 8px;" data-bs-dismiss="modal">Cancelar</button>
                <form id="confirmForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn px-4 fw-bold" style="border-radius: 8px;" id="confirmBtn"></button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('confirmModal');
            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const action = button.getAttribute('data-action');
                const id = button.getAttribute('data-id');
                const message = button.getAttribute('data-message');
                const btnText = button.getAttribute('data-btn-text');
                const btnClass = button.getAttribute('data-btn-class');

                document.getElementById('confirmModalLabel').textContent = message;
                const confirmBtn = document.getElementById('confirmBtn');
                confirmBtn.textContent = btnText;
                confirmBtn.className = 'btn px-4 fw-bold ' + btnClass;
                document.getElementById('confirmForm').action = '/' + action + '/' + id;
            });
        });
    </script>
}
