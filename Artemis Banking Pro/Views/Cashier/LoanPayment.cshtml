@model ABP.Core.Application.ViewModels.Cashier.LoanPaymentViewModel
@{
    ViewData["Title"] = "Pago a Préstamo";
}

<div class="container-xxl px-4 mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <a asp-controller="Cashier" asp-action="Home" class="text-muted mb-4 d-inline-block text-decoration-none" style="transition: color 0.2s;">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver al Panel
            </a>

            <div class="card border-0 overflow-hidden" style="background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #e5e7eb !important;">
                <div class="card-header border-0 bg-transparent p-4 pb-0">
                    <h3 class="text-dark fw-bold mb-0" style="font-family: 'Outfit', sans-serif;">
                        <i class="fa-solid fa-hand-holding-dollar me-2" style="color: #7c3aed;"></i>Pago a Préstamo
                    </h3>
                    <p class="text-muted mt-1" style="font-size: 0.85rem;">Abona al saldo pendiente de un préstamo.</p>
                </div>

                <div class="card-body p-4 pt-3">
                    <form asp-controller="Cashier" asp-action="LoanPayment" method="post" id="loanPayForm">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" style="border-radius: 10px; font-size: 0.9rem;">
                                <i class="fa-solid fa-circle-exclamation me-2"></i><strong>Revise los errores:</strong>
                                <ul class="mb-0 mt-1">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Préstamo -->
                        <div class="mb-4">
                            <label asp-for="LoanNumber" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Número de Préstamo</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted" style="border: 1px solid #e5e7eb;"><i class="fa-solid fa-file-invoice-dollar"></i></span>
                                <input asp-for="LoanNumber" class="form-control bg-light border-start-0 ps-0 text-dark" style="border: 1px solid #e5e7eb; font-family: monospace; font-size: 1.1rem; box-shadow: none;" placeholder="Ej. PR-00123456" autofocus />
                            </div>
                            <span asp-validation-for="LoanNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Cuenta de Origen -->
                        <div class="mb-4">
                            <label asp-for="OriginAccountNumber" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Cuenta de Ahorro Origen</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted" style="border: 1px solid #e5e7eb;"><i class="fa-solid fa-piggy-bank"></i></span>
                                <input asp-for="OriginAccountNumber" class="form-control bg-light border-start-0 ps-0 text-dark" style="border: 1px solid #e5e7eb; font-family: monospace; font-size: 1.1rem; box-shadow: none;" placeholder="Ej. 123456789" />
                            </div>
                            <span asp-validation-for="OriginAccountNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Monto -->
                        <div class="mb-4">
                            <label asp-for="Amount" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Monto a Pagar</label>
                            <div class="position-relative">
                                <span class="position-absolute text-dark fs-4 fw-bold" style="left: 15px; top: 50%; transform: translateY(-50%); font-family: 'Outfit', sans-serif;">RD$</span>
                                <input asp-for="Amount" type="number" step="0.01" min="1" class="form-control bg-light text-dark fw-bold" style="border: 1px solid #e5e7eb; font-family: 'Outfit', sans-serif; font-size: 2rem; box-shadow: none; padding-left: 70px; height: 70px;" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                        </div>
                        
                        <div class="alert alert-info mb-5" style="border-radius: 10px; font-size: 0.85rem; border: 1px solid #e0e7ff; background-color: #eef2ff; color: #4338ca;">
                            <i class="fa-solid fa-circle-info me-2"></i>El monto del pago no puede exceder el saldo pendiente del préstamo.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn w-100 py-3 fw-bold text-white" id="submitBtn" style="background: #7c3aed; border: none; border-radius: 10px; font-size: 1.05rem; box-shadow: 0 4px 15px rgba(124,58,237,0.3); transition: all 0.3s ease;">
                                <i class="fa-solid fa-check me-2"></i>Confirmar Pago
                            </button>
                            <a asp-controller="Cashier" asp-action="Home" class="btn btn-light w-100 py-2 fw-semibold" style="border-radius: 10px; color: #64748b;">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('loanPayForm').addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Procesando...';
        });
    </script>
}
